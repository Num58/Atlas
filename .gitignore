# =============================================================================
# PrimeAtlas .gitignore
# Keep the repository lean, professional, and free of tool/agent residue.
# =============================================================================

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.iml
*.freezed.dart
*.g.dart

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# --- Secrets ---
.env
.env.*
!.env.example

# --- Large toolchains (never commit) ---
.flutter-sdk/
.workbuddy-runtime/
android-device-lab/
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/ios/Flutter/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# --- Logs ---
*.log
logs/

# --- Agent / diagnostics residue (repo root hygiene) ---
*.capture.txt
*-capture.txt
*-output.txt
*-diff.txt
*-numstat.txt
*-exit.txt
*-heldout.txt
*-precheck.txt
*-status.txt
*-results.txt
*-result.txt
*-residual.txt
*-unique.txt
*-specialty.txt
*-script-parse.txt
*-p0-emoji.txt
*-wiring-check.txt
*-test-retry*.txt
*-unit-test.txt
*-analyze*.txt
flutter-version-code.txt
dart-analyze-*.txt
node-version.txt
git-status-output.txt
analyze-capture.txt
core-diff.txt
core-numstat.txt
frontend-*.txt
journey-*.txt
v6-*.txt
sqlite-*.txt
flutter-out.txt

# --- Local runtime data ---
.primeatlas/
*.db
!test/**/fixtures/**/*.db

# --- Temporary ---
tmp/
.temp/
*.tmp
